<%- include("../parciales/cabecera", { tituloPagina }) %>

<h1>Crear una cuenta</h1>

<form class="bloque" action="/registro" method="post" novalidate>
  <label for="nombre">Nombre</label>
  <input id="nombre" name="nombre" value="<%= valores.nombre %>">
  <% if (errores.nombre) { %>
    <p class="error"><%= errores.nombre %></p>
  <% } %>

  <label for="email">Correo electrónico</label>
  <input id="email" name="email" type="email" value="<%= valores.email %>">
  <% if (errores.email) { %>
    <p class="error"><%= errores.email %></p>
  <% } %>

  <label for="password">Contraseña (mínimo 8 caracteres)</label>
  <input id="password" name="password" type="password">
  <% if (errores.password) { %>
    <p class="error"><%= errores.password %></p>
  <% } %>

  <button type="submit">Registrarme</button>
</form>

<%- include("../parciales/pie") %>
